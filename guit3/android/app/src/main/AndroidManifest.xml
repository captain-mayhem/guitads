<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- the engine's renderer needs OpenGL ES 3.0 -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- enableOnBackInvokedCallback: back reaches CgeActivity's callback on
         Android 13 and later -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.GuiT3">

        <!-- the list of games; copies guit3's runtime files into the app's
             storage and starts GuiT3Activity with a game. Not restarted by
             configuration changes, since copying runs in a thread of the
             activity -->
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:theme="@style/Theme.GuiT3.Launcher"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- guit3, the engine's NativeActivity: the configuration changes
             don't restart it (the engine checks the window's size every
             frame), and only one instance runs, since the engine is a
             singleton. In a process of its own, which ends with guit3: the
             TADS runtime isn't set up again for a second run in a process
             (guimain.cpp's android_main) -->
        <activity
            android:name=".GuiT3Activity"
            android:exported="false"
            android:process=":game"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode|fontScale|locale|layoutDirection">
            <meta-data android:name="android.app.lib_name" android:value="guit3" />
        </activity>
    </application>
</manifest>
